<UserControl x:Class="KotobaOdyssey.UI.Views.VocabularyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="Transparent">
    <Grid Margin="32">
        <Border Style="{StaticResource StyleCosmicCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" MaxWidth="600">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#1C2642" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource GeomVocab}" Fill="{StaticResource BrushStarGold}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="語彙と復習 (Vocabulary &amp; Review)" Style="{StaticResource TextHeaderLarge}" HorizontalAlignment="Center" />
                <TextBlock Text="Hệ thống thẻ ghi nhớ Flashcard thông minh, đánh giá Again / Hard / Good / Easy và lập lịch lặp lại ngắt quãng (SM-2 Spaced Repetition)." 
                           Style="{StaticResource TextSubheader}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20" />
                <Border Background="#1C2138" CornerRadius="8" Padding="14,10" HorizontalAlignment="Center">
                    <TextBlock Text="✦ Phase 3: Spaced Repetition &amp; Flashcards ✦" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushStarGold}" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
