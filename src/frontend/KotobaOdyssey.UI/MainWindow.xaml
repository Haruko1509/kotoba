<Window x:Class="KotobaOdyssey.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KotobaOdyssey.UI.ViewModels"
        xmlns:views="clr-namespace:KotobaOdyssey.UI.Views"
        mc:Ignorable="d"
        Title="Kotoba Odyssey — 言葉のオデッセイ" 
        Height="840" Width="1340"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushAppBg}">

    <Window.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderViewModel}">
            <views:ReaderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VocabularyViewModel}">
            <views:VocabularyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VisualNovelViewModel}">
            <views:VisualNovelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource BrushSidebarBg}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cosmic Logo Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" 
                                Background="{StaticResource BrushPrimaryButton}"
                                HorizontalAlignment="Left">
                            <Path Data="{StaticResource GeomVisualNovel}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Brand Title -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="KOTOBA ODYSSEY" 
                                       FontFamily="{StaticResource FontDisplay}" 
                                       FontSize="14" FontWeight="Bold" 
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="言葉のオデッセイ" 
                                       FontFamily="{StaticResource FontJapanese}" 
                                       FontSize="11" 
                                       Foreground="{StaticResource BrushLavender}" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,18,0,0" />
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="NAVIGATION" Style="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="14,0,0,8" />

                        <!-- 1. Dashboard -->
                        <RadioButton Style="{StaticResource StyleNavButton}"
                                     GroupName="SidebarNav"
                                     IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityToBool}, ConverterParameter=Dashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource GeomDashboard}" Fill="{StaticResource BrushVioletLight}" Width="18" Height="18" Stretch="Uniform" />
                            </RadioButton.Tag>
                            <StackPanel>
                                <TextBlock Text="Dashboard" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                                <TextBlock Text="ダッシュボード" Style="{StaticResource TextMuted}" FontSize="10" FontFamily="{StaticResource FontJapanese}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 2. Novel Library -->
                        <RadioButton Style="{StaticResource StyleNavButton}"
                                     GroupName="SidebarNav"
                                     IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityToBool}, ConverterParameter=Library, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Library">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource GeomLibrary}" Fill="{StaticResource BrushLavender}" Width="18" Height="18" Stretch="Uniform" />
                            </RadioButton.Tag>
                            <StackPanel>
                                <TextBlock Text="Novel Library" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                                <TextBlock Text="小説ライブラリ" Style="{StaticResource TextMuted}" FontSize="10" FontFamily="{StaticResource FontJapanese}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 3. Reading Workspace -->
                        <RadioButton Style="{StaticResource StyleNavButton}"
                                     GroupName="SidebarNav"
                                     IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityToBool}, ConverterParameter=Reader, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Reader">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource GeomReader}" Fill="{StaticResource BrushStarlightCyan}" Width="18" Height="18" Stretch="Uniform" />
                            </RadioButton.Tag>
                            <StackPanel>
                                <TextBlock Text="Reader Workspace" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                                <TextBlock Text="リーディング" Style="{StaticResource TextMuted}" FontSize="10" FontFamily="{StaticResource FontJapanese}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 4. Vocabulary & Review -->
                        <RadioButton Style="{StaticResource StyleNavButton}"
                                     GroupName="SidebarNav"
                                     IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityToBool}, ConverterParameter=Vocabulary, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Vocabulary">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource GeomVocab}" Fill="{StaticResource BrushStarGold}" Width="18" Height="18" Stretch="Uniform" />
                            </RadioButton.Tag>
                            <StackPanel>
                                <TextBlock Text="Vocabulary &amp; SRS" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                                <TextBlock Text="語彙と復習" Style="{StaticResource TextMuted}" FontSize="10" FontFamily="{StaticResource FontJapanese}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 5. Visual Novel Mode -->
                        <RadioButton Style="{StaticResource StyleNavButton}"
                                     GroupName="SidebarNav"
                                     IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityToBool}, ConverterParameter=VisualNovel, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="VisualNovel">
                            <RadioButton.Tag>
                                <Path Data="{StaticResource GeomVisualNovel}" Fill="{StaticResource BrushCherryPink}" Width="18" Height="18" Stretch="Uniform" />
                            </RadioButton.Tag>
                            <StackPanel>
                                <TextBlock Text="Visual Novel Mode" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                                <TextBlock Text="ビジュアルノベル" Style="{StaticResource TextMuted}" FontSize="10" FontFamily="{StaticResource FontJapanese}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Sidebar: Settings & System -->
                <StackPanel Grid.Row="2" Margin="10,12">
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,10" />

                    <!-- Settings -->
                    <RadioButton Style="{StaticResource StyleNavButton}"
                                 GroupName="SidebarNav"
                                 IsChecked="{Binding CurrentPageKey, Converter={StaticResource EqualityToBool}, ConverterParameter=Settings, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <RadioButton.Tag>
                            <Path Data="{StaticResource GeomSettings}" Fill="{StaticResource BrushTextSecondary}" Width="18" Height="18" Stretch="Uniform" />
                        </RadioButton.Tag>
                        <StackPanel>
                            <TextBlock Text="Settings" Style="{StaticResource TextBody}" FontWeight="SemiBold" />
                            <TextBlock Text="設定" Style="{StaticResource TextMuted}" FontSize="10" FontFamily="{StaticResource FontJapanese}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#0C1222" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title / Cosmic Compass Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1C2642" CornerRadius="6" Padding="6,4" Margin="0,0,10,0">
                            <Path Data="{StaticResource GeomDashboard}" Fill="{StaticResource BrushVioletLight}" Width="14" Height="14" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding CurrentPageKey}" Style="{StaticResource TextHeaderMedium}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="• Odyssey Gateway" Style="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Top Right User Profile & Gamification Stats -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Streak Flame Badge -->
                        <Border Background="#2B1D16" BorderBrush="#522E1A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeomFlame}" Fill="{StaticResource BrushFlameOrange}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StreakDays, StringFormat='{}{0} DAYS'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushFlameOrange}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Level & XP Status Capsule -->
                        <Border Background="#131B30" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <!-- Level Tag -->
                                <Border Background="{StaticResource BrushVioletPrimary}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Level, StringFormat='{}Lv. {0}'}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>

                                <!-- XP Progress Details -->
                                <StackPanel VerticalAlignment="Center" Width="130">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="XP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushLavender}" />
                                        <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource BrushTextSecondary}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                    <Binding Path="CurrentXp" />
                                                    <Binding Path="RequiredXp" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding XpProgressPercentage}" Maximum="100" Style="{StaticResource StyleCosmicProgressBar}" Height="5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- User Avatar -->
                        <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{StaticResource BrushBorderGlow}" BorderThickness="2" Background="#1D2746">
                            <TextBlock Text="旅" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushLavender}" FontFamily="{StaticResource FontJapanese}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Content Container -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="#080C16" BorderBrush="#161F34" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource BrushEmerald}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
