<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Solid Colors (Astral Journey: Midnight Navy & Charcoal) -->
    <Color x:Key="ColorAppBg">#090C14</Color>
    <Color x:Key="ColorSidebarBg">#0C101A</Color>
    <Color x:Key="ColorSurfaceBg">#121826</Color>
    <Color x:Key="ColorSurfaceHover">#1A2234</Color>
    <Color x:Key="ColorSurfaceActive">#222D44</Color>
    <Color x:Key="ColorBorder">#1E283C</Color>
    <Color x:Key="ColorBorderGlow">#3D4878</Color>

    <!-- Warm Paper Mode -->
    <Color x:Key="ColorPaperBg">#FDF9EE</Color>
    <Color x:Key="ColorPaperText">#2D241E</Color>

    <!-- Astral Accent Colors -->
    <Color x:Key="ColorVioletPrimary">#6366F1</Color>
    <Color x:Key="ColorVioletLight">#818CF8</Color>
    <Color x:Key="ColorLavender">#C7D2FE</Color>
    <Color x:Key="ColorStarlightCyan">#06B6D4</Color>
    <Color x:Key="ColorCherryPink">#F43F5E</Color>
    <Color x:Key="ColorStarGold">#F59E0B</Color>
    <Color x:Key="ColorEmerald">#10B981</Color>
    <Color x:Key="ColorFlameOrange">#F97316</Color>

    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource ColorAppBg}" />
    <SolidColorBrush x:Key="BrushSidebarBg" Color="{StaticResource ColorSidebarBg}" />
    <SolidColorBrush x:Key="BrushSurfaceBg" Color="{StaticResource ColorSurfaceBg}" />
    <SolidColorBrush x:Key="BrushSurfaceHover" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="BrushSurfaceActive" Color="{StaticResource ColorSurfaceActive}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderGlow" Color="{StaticResource ColorBorderGlow}" />

    <SolidColorBrush x:Key="BrushPaperBg" Color="{StaticResource ColorPaperBg}" />
    <SolidColorBrush x:Key="BrushPaperText" Color="{StaticResource ColorPaperText}" />

    <SolidColorBrush x:Key="BrushVioletPrimary" Color="{StaticResource ColorVioletPrimary}" />
    <SolidColorBrush x:Key="BrushVioletLight" Color="{StaticResource ColorVioletLight}" />
    <SolidColorBrush x:Key="BrushLavender" Color="{StaticResource ColorLavender}" />
    <SolidColorBrush x:Key="BrushStarlightCyan" Color="{StaticResource ColorStarlightCyan}" />
    <SolidColorBrush x:Key="BrushCherryPink" Color="{StaticResource ColorCherryPink}" />
    <SolidColorBrush x:Key="BrushStarGold" Color="{StaticResource ColorStarGold}" />
    <SolidColorBrush x:Key="BrushEmerald" Color="{StaticResource ColorEmerald}" />
    <SolidColorBrush x:Key="BrushFlameOrange" Color="{StaticResource ColorFlameOrange}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="BrushHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1838" Offset="0" />
        <GradientStop Color="#162244" Offset="0.5" />
        <GradientStop Color="#14182E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPrimaryButton" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8262FD" Offset="0" />
        <GradientStop Color="#6342E8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushPrimaryButtonHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9A80FE" Offset="0" />
        <GradientStop Color="#7556F0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FDE68A" Offset="0" />
        <GradientStop Color="#F59E0B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCyanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0" />
        <GradientStop Color="#0284C7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushXpBarGradient" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#38BDF8" Offset="0" />
        <GradientStop Color="#818CF8" Offset="0.5" />
        <GradientStop Color="#C084FC" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCardBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#453872" Offset="0" />
        <GradientStop Color="#1E2844" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
